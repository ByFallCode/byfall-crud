{
  "name": "byfallcode/byfall-crud",
  "description": "Laravel API CRUD generator (models, repositories, requests, controllers, resources, factories, seeders, Postman collections)",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Byfall Code",
      "email": "contact@byfallcode.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0 || ^11.0 || ^12.0",
    "illuminate/database": "^10.0 || ^11.0 || ^12.0",
    "illuminate/filesystem": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "autoload": {
    "psr-4": {
      "ByfallCode\\ByfallCrud\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ByfallCode\\ByfallCrud\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "ByfallCode\\ByfallCrud\\ByfallCrudServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
